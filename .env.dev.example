# Server
SERVER_PORT=8080

# Persistent storage path set by Compose.
STORAGE_LOCAL_DIR=/workspace/storage
STORAGE_PROVIDER=local

AWS_ACCESS_KEY_ID=
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=boero/

# Database
DB_HOST=postgres
DB_NAME=boero_db
DB_PASSWORD=boero
DB_PORT=5432
DB_USER=boero

# Security
JWT_SECRET=0123456789abcdef0123456789abcdef
REFRESH_REPLAY_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
REFRESH_REPLAY_TTL=5s

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@boero.local

# Password recovery
PASSWORD_RECOVERY_FRONTEND_URL=http://localhost:3000
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# WebAuthn / Passkeys
# Generic local RP. Local institutional requests use their own trusted hostname.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Boero
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL=PT5M
WEBAUTHN_LOGIN_ATTEMPT_TTL=PT5M
WEBAUTHN_MAX_PASSKEYS=10
WEBAUTHN_RECENT_AUTH_TTL=PT5M

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s

# Generic origin keeps the selector; a configured public name selects its institution.
FRONTEND_PUBLIC_URL=http://localhost:3000
INSTITUTIONAL_BASE_DOMAIN=localhost

# Optional institutional auto-login; blocked in production.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=
