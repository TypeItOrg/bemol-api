# ============================================================
#  SERVER
# ============================================================

SERVER_PORT=8080

# ============================================================
#  DATABASE
# ============================================================

DB_HOST=postgres
DB_NAME=bemol_db
DB_PASSWORD=bemol
DB_PORT=5432
DB_USER=bemol

# ============================================================
#  REDIS
# ============================================================

REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================
#  S3 STORAGE
# ============================================================

STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=bemol/
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SESSION_TOKEN=

# ============================================================
#  SECURITY
# ============================================================

JWT_SECRET=
REFRESH_REPLAY_ENCRYPTION_KEY=
REFRESH_REPLAY_TTL=5s

# ============================================================
#  WEBAUTHN / PASSKEYS
# ============================================================

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bemol
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL=PT5M
WEBAUTHN_LOGIN_ATTEMPT_TTL=PT5M
WEBAUTHN_MAX_PASSKEYS=10
WEBAUTHN_RECENT_AUTH_TTL=PT5M

# ============================================================
#  MAIL
# ============================================================

MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@bemol.local
BRAND_LOGO_URL=

# ============================================================
#  EMAIL VERIFICATION
# ============================================================

EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s

# ============================================================
#  PASSWORD RECOVERY
# ============================================================

PASSWORD_RECOVERY_FRONTEND_URL=http://localhost:3000
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# ============================================================
#  FRONTEND
# ============================================================

FRONTEND_PUBLIC_URL=http://localhost:3000
INSTITUTIONAL_BASE_DOMAIN=localhost

# ============================================================
#  PLATFORM
# ============================================================

PLATFORM_PUBLIC_URL=http://admin.localhost:3000
PLATFORM_PASSKEY_REQUIRED=false

# ============================================================
#  AUTO-LOGIN (OPTIONAL)
# ============================================================

AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=
