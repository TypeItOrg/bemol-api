# Server
SERVER_PORT=8080

# Persistent writable storage directory.
STORAGE_LOCAL_DIR=storage
STORAGE_PROVIDER=local

AWS_ACCESS_KEY_ID=
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=boero/

# Database
DB_HOST=postgres
DB_NAME=boero_db
DB_PASSWORD=boero
DB_PORT=5432
DB_USER=boero

# Security
JWT_SECRET=change-me-to-a-32-byte-or-longer-secret-for-hs256
REFRESH_REPLAY_ENCRYPTION_KEY=base64-encoded-32-byte-key
REFRESH_REPLAY_TTL=5s

# Mail
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@bemol.local

# Password recovery
PASSWORD_RECOVERY_FRONTEND_URL=http://localhost:3000
PASSWORD_RECOVERY_TOKEN_EXPIRATION=30m

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Bemol
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL=PT5M
WEBAUTHN_LOGIN_ATTEMPT_TTL=PT5M
WEBAUTHN_MAX_PASSKEYS=10
WEBAUTHN_RECENT_AUTH_TTL=PT5M

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Email verification
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
EMAIL_VERIFICATION_RESEND_INTERVAL=60s

# Optional institutional auto-login; blocked in production.
AUTO_LOGIN_ENABLED=false
AUTO_LOGIN_USER_ID=
AUTO_LOGIN_INSTITUTION_ID=
