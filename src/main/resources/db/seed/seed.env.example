# Export these variables; run.sh does not load this file.
# Required active institution slug.
SEED_INSTITUTION=codigo-de-tu-institucion
# Omit to use the current year; set it to reproduce a run.
SEED_YEAR=2026
# Omit to use September 1 of SEED_YEAR; date must be in that year.
SEED_REFERENCE_DATE=2026-09-01
SEED_TIMEZONE=America/Argentina/Cordoba
# Connection method: compose or psql.
SEED_TRANSPORT=compose
SEED_DB_SERVICE=postgres
# Optional Compose file path.
SEED_COMPOSE_FILE=
